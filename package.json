{
  "name": "pipefy-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "worker:dev": "wrangler dev",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "dexie": "^4.4.7",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-grid-layout": "^1.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261120.1",
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.19.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/react-grid-layout": "^1.3.6",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "fake-indexeddb": "^6.2.8",
    "globals": "^15.15.0",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^7.3.8",
    "vitest": "^4.1.12",
    "wrangler": "^4.166.0"
  },
  "engines": {
    "node": ">=20.19"
  }
}
